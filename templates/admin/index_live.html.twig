{#
 # LiveComponent-powered entity list template.
 # Use this instead of index.html.twig for reactive lists.
 #
 # Variables:
 # @var string entityClass - Full class name of the entity
 # @var string entityShortClass - Short class name of the entity
 # @var string|null repositoryMethod - Custom repository method for query
 # @var array scope - Optional collection scope ({ownerClass, ownerId, property}) from ?collection=Owner:id:property
 #}
{% extends kachnitel_admin_base_layout ?: '@KachnitelAdmin/admin/base.html.twig' %}

{% import kachnitel_admin_theme as css %}

{% block title %}
    {{ title|default(entityLabel|default(entityShortClass)) }}
{% endblock %}

{% block headerTitle %}
    {{ title|default(entityLabel|default(entityShortClass)) }}
{% endblock %}

{% block headerButtons %}
    {% if admin_action_accessible(entityShortClass, 'new') %}
        <a href="{{ admin_object_path(entityClass, 'new', { class: entityShortClass }) }}" class="{{ css.btn_primary() }}">
            {% block newButtonLabel %}
                ➕ New
            {% endblock %}
        </a>
    {% endif %}
{% endblock %}

{% block content %}
    {% set scope = scope|default([]) %}
    {% if scope is not empty %}
        <p class="admin-collection-scope-banner" data-testid="collection-scope-banner">
            <strong>{{ scope.property|humanize }}</strong>
            of {{ scope.ownerClass|split('\\')|last }} #{{ scope.ownerId }}
            <a href="{{ path(app.current_route, app.current_route_parameters) }}" aria-label="Clear collection scope" title="Show all">✕</a>
        </p>
    {% endif %}
    <twig:K:Admin:EntityList
        :entityShortClass="entityShortClass"
        :repositoryMethod="repositoryMethod|default(null)"
        :scope="scope"
    />
{% endblock %}
